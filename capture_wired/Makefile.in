include ../Makefile.inc

MONITOR_OBJS = \
	wired_util.c.o \
	wired_sysfs.c.o \
	wired_priv.c.o \
	capture_wired.c.o

MONITOR_BIN = kismet_cap_wired

# Built on request, not by 'all', and never installed:
#   make -C capture_wired test     unit tests, and the privilege drop test (run it
#                                  unprivileged, or as root for the uid switch)
#   make -C capture_wired replay   the helper reading a pcap file (replay=) instead of
#                                  an interface, for testing the server paths unprivileged
TEST_BIN = ../test/wired_helper/wired_test
TEST_OBJS = \
	../test/wired_helper/wired_test.c.o \
	wired_util.c.o \
	wired_sysfs.c.o

PRIV_TEST_BIN = ../test/wired_helper/priv_test
PRIV_TEST_OBJS = \
	../test/wired_helper/priv_test.c.o \
	wired_util.c.o \
	wired_priv.c.o

REPLAY_DIR = replay
REPLAY_BIN = $(REPLAY_DIR)/kismet_cap_wired
REPLAY_SRCS = wired_util.c wired_sysfs.c wired_priv.c capture_wired.c

PCAPLIBS=@PCAPLIBS@
CFLAGS+=@PCAPCFLAGS@

all: $(MONITOR_BIN)

$(MONITOR_BIN):	$(MONITOR_OBJS) $(patsubst %c.o,%c.d,$(MONITOR_OBJS)) ../libkismetdatasource.a
		$(CCLD) $(LDFLAGS) -o $(MONITOR_BIN) $(MONITOR_OBJS) ../libkismetdatasource.a $(PCAPLIBS) $(DATASOURCE_LIBS)

test: $(TEST_BIN) $(PRIV_TEST_BIN)

$(TEST_BIN): $(TEST_OBJS) ../libkismetdatasource.a
		$(CCLD) $(LDFLAGS) -o $@ $(TEST_OBJS) ../libkismetdatasource.a $(PCAPLIBS) $(DATASOURCE_LIBS)

$(PRIV_TEST_BIN): $(PRIV_TEST_OBJS) ../libkismetdatasource.a
		$(CCLD) $(LDFLAGS) -o $@ $(PRIV_TEST_OBJS) ../libkismetdatasource.a $(DATASOURCE_LIBS)

replay: $(REPLAY_BIN)

$(REPLAY_BIN): $(REPLAY_SRCS) wired_util.h wired_sysfs.h wired_priv.h ../libkismetdatasource.a
		mkdir -p $(REPLAY_DIR)
		$(CC) $(CFLAGS) $(CPPFLAGS) -DWIRED_REPLAY $(LDFLAGS) -o $@ $(REPLAY_SRCS) \
			../libkismetdatasource.a $(PCAPLIBS) $(DATASOURCE_LIBS)

clean:
	@-rm -f $(MONITOR_BIN) $(TEST_BIN) $(PRIV_TEST_BIN) $(REPLAY_BIN)
	@-rm -f ../test/wired_helper/*.o ../test/wired_helper/*.d
	@-rm -f *.o
	@-rm -f *.d

%.c.o:	%.c
%.c.o : %.c %.c.d
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $*.c -o $@ -MMD -MP -MF $(@:.o=.d)

%.c.d:	%.c
	$(CC) -MM $(CFLAGS) $(CPPFLAGS) $*.c | sed -e "s/\.o/\.c.o/" > $*.c.d

.PRECIOUS: %.c.d

include $(wildcard $(patsubst %c.o,%c.d,$(MONITOR_OBJS)))
