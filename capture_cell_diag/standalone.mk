check: $(TESTS)
	@for t in $(TESTS); do echo "--- $$t"; ./$$t || exit 1; done
	@echo "PASS: standalone celldiag selftests"

# $(NATIVE_DIR) (with $(BASELINE_DIR) inside it) is ours alone, and leaving a
# stale one behind is how a "clean rebuild" reads green off yesterday's
# config.h. The `rm -rf` never touches the generated Makefile's
# ./kismet_cap_cell_diag.
clean:
	rm -f $(LOGSTREAM_DUMP_BIN) $(TESTS)
	rm -rf $(NATIVE_DIR)

.PHONY: all check clean

# The tree's own capture, replayed by `functional`. FUNCTIONAL_IMEI is the
# all-zero placeholder a replay source is addressed by.
FUNCTIONAL_FIXTURE  = fixtures/functional.hdlc
FUNCTIONAL_IMEI     = 000000000000000
