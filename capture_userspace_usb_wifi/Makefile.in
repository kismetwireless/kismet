include ../Makefile.inc

# Userspace USB Wi-Fi: Linux drivers built unmodified against kernel and mac80211
# emulation on libusb, vendored from userspace-wifi (see userspace-wifi/VENDOR)

prefix = @prefix@
datarootdir = @datarootdir@
FIRMWAREDIR = @datadir@/kismet/firmware

V = userspace-wifi

# Kernel headers resolve to kcompat first, then the unmodified upstream wireless headers
KC_INCLUDES = -I$(V)/kcompat/include -I$(V)/kcompat/upstream -I$(V)/kcompat/upstream/uapi
KC_CFLAGS = -std=gnu11 -pthread -MMD -MP $(KC_INCLUDES) $(LIBUSBCFLAGS) -O2 -g -fPIE \
	-ffunction-sections -fdata-sections

# Our kernel-side code
OWN_CFLAGS = $(KC_CFLAGS) -Wall -Wextra @USBWIFI_WNOCFLAGS@ \
	-I$(V) -I$(V)/mac80211 -I$(V)/drivers

# Vendored kernel code, built as-is; kernel style trips warnings that aren't ours to fix
MODNAME = mt76
DRV_CFLAGS = $(KC_CFLAGS) -w -I$(V)/drivers/mt76 -DKBUILD_MODNAME='"$(MODNAME)"'
RTW88_CFLAGS = $(KC_CFLAGS) -w -I$(V)/drivers/rtw88 -DKBUILD_MODNAME='"$(MODNAME)"'

# The capture binary uses Kismet's headers, not kcompat's
CAP_CFLAGS = $(CFLAGS) -MMD -MP -I.. -DFIRMWAREDIR=\"$(FIRMWAREDIR)\"

KCOMPAT_OBJS = \
	$(V)/kcompat/src/core.o \
	$(V)/kcompat/src/sched.o \
	$(V)/kcompat/src/skb.o \
	$(V)/kcompat/src/usb.o

MAC80211_OBJS = \
	$(V)/mac80211/main.o \
	$(V)/mac80211/rx.o \
	$(V)/mac80211/tx.o \
	$(V)/mac80211/cfg80211.o \
	$(V)/kcompat/upstream/radiotap.o

MT76_OBJS = \
	$(V)/drivers/mt76/mac80211.o \
	$(V)/drivers/mt76/util.o \
	$(V)/drivers/mt76/mcu.o \
	$(V)/drivers/mt76/tx.o \
	$(V)/drivers/mt76/eeprom.o \
	$(V)/drivers/mt76/channel.o \
	$(V)/drivers/mt76/agg-rx.o \
	$(V)/drivers/mt76/scan.o \
	$(V)/drivers/mt76/usb.o \
	$(V)/drivers/mt76/mt76_connac_mcu.o \
	$(V)/drivers/mt76/mt76_connac_mac.o \
	$(V)/drivers/mt76/mt76_connac3_mac.o \
	$(V)/drivers/mt76/mt792x_core.o \
	$(V)/drivers/mt76/mt792x_mac.o \
	$(V)/drivers/mt76/mt792x_usb.o \
	$(V)/drivers/mt76/mt76x02_util.o \
	$(V)/drivers/mt76/mt76x02_mac.o \
	$(V)/drivers/mt76/mt76x02_mcu.o \
	$(V)/drivers/mt76/mt76x02_eeprom.o \
	$(V)/drivers/mt76/mt76x02_phy.o \
	$(V)/drivers/mt76/mt76x02_txrx.o \
	$(V)/drivers/mt76/mt76x02_dfs.o \
	$(V)/drivers/mt76/mt76x02_beacon.o \
	$(V)/drivers/mt76/mt76x02_usb_mcu.o \
	$(V)/drivers/mt76/mt76x02_usb_core.o \
	$(V)/drivers/mt76/mt7921/init.o \
	$(V)/drivers/mt76/mt7921/main.o \
	$(V)/drivers/mt76/mt7921/mac.o \
	$(V)/drivers/mt76/mt7921/mcu.o \
	$(V)/drivers/mt76/mt7921/usb.o \
	$(V)/drivers/mt76/mt7921/regd.o \
	$(V)/drivers/mt76/mt7925/init.o \
	$(V)/drivers/mt76/mt7925/main.o \
	$(V)/drivers/mt76/mt7925/mac.o \
	$(V)/drivers/mt76/mt7925/mcu.o \
	$(V)/drivers/mt76/mt7925/usb.o \
	$(V)/drivers/mt76/mt7925/regd.o \
	$(V)/drivers/mt76/mt7925/nan.o \
	$(V)/drivers/mt76/mt76x2/eeprom.o \
	$(V)/drivers/mt76/mt76x2/mac.o \
	$(V)/drivers/mt76/mt76x2/init.o \
	$(V)/drivers/mt76/mt76x2/phy.o \
	$(V)/drivers/mt76/mt76x2/mcu.o \
	$(V)/drivers/mt76/mt76x2/usb.o \
	$(V)/drivers/mt76/mt76x2/usb_init.o \
	$(V)/drivers/mt76/mt76x2/usb_main.o \
	$(V)/drivers/mt76/mt76x2/usb_mac.o \
	$(V)/drivers/mt76/mt76x2/usb_mcu.o \
	$(V)/drivers/mt76/mt76x2/usb_phy.o

# rtw88 USB: core, USB transport and every chip with a USB part; no PCI, SDIO or LEDs
RTW88_OBJS = \
	$(V)/drivers/rtw88/main.o \
	$(V)/drivers/rtw88/mac80211.o \
	$(V)/drivers/rtw88/util.o \
	$(V)/drivers/rtw88/debug.o \
	$(V)/drivers/rtw88/tx.o \
	$(V)/drivers/rtw88/rx.o \
	$(V)/drivers/rtw88/mac.o \
	$(V)/drivers/rtw88/phy.o \
	$(V)/drivers/rtw88/coex.o \
	$(V)/drivers/rtw88/efuse.o \
	$(V)/drivers/rtw88/fw.o \
	$(V)/drivers/rtw88/ps.o \
	$(V)/drivers/rtw88/sec.o \
	$(V)/drivers/rtw88/bf.o \
	$(V)/drivers/rtw88/sar.o \
	$(V)/drivers/rtw88/regd.o \
	$(V)/drivers/rtw88/usb.o \
	$(V)/drivers/rtw88/rtw88xxa.o \
	$(V)/drivers/rtw88/rtw8812a.o \
	$(V)/drivers/rtw88/rtw8812a_table.o \
	$(V)/drivers/rtw88/rtw8812au.o \
	$(V)/drivers/rtw88/rtw8821a.o \
	$(V)/drivers/rtw88/rtw8821a_table.o \
	$(V)/drivers/rtw88/rtw8821au.o \
	$(V)/drivers/rtw88/rtw8814a.o \
	$(V)/drivers/rtw88/rtw8814a_table.o \
	$(V)/drivers/rtw88/rtw8814au.o \
	$(V)/drivers/rtw88/rtw8822b.o \
	$(V)/drivers/rtw88/rtw8822b_table.o \
	$(V)/drivers/rtw88/rtw8822bu.o \
	$(V)/drivers/rtw88/rtw8822c.o \
	$(V)/drivers/rtw88/rtw8822c_table.o \
	$(V)/drivers/rtw88/rtw8822cu.o \
	$(V)/drivers/rtw88/rtw8821c.o \
	$(V)/drivers/rtw88/rtw8821c_table.o \
	$(V)/drivers/rtw88/rtw8821cu.o \
	$(V)/drivers/rtw88/rtw8723x.o \
	$(V)/drivers/rtw88/rtw8723d.o \
	$(V)/drivers/rtw88/rtw8723d_table.o \
	$(V)/drivers/rtw88/rtw8723du.o

# Morse Micro MM8108 802.11ah
MM8108_OBJS = \
	$(V)/drivers/mm8108/mm8108.o \
	$(V)/drivers/mm8108/mm_usb.o \
	$(V)/drivers/mm8108/mm_hw.o \
	$(V)/drivers/mm8108/mm_fw.o \
	$(V)/drivers/mm8108/mm_yaps.o \
	$(V)/drivers/mm8108/mm_cmd.o \
	$(V)/drivers/mm8108/mm_channels.o \
	$(V)/drivers/mm8108/mm_channel_tables.o \
	$(V)/drivers/mm8108/mm_s1g.o \
	$(V)/drivers/mm8108/mac.o

GLUE_OBJS = \
	$(V)/drivers/mt76_glue.o

# Firmware loading is libkismetdatasource's firmware_file, so $(V)/common/firmware_file.c isn't built
COMMON_OBJS = \
	$(V)/common/uwifi.o \
	$(V)/common/pcap.o

KISMET_OBJS = \
	common/uwifi_kismet.o \
	common/wifi_ht_channels.o

# The core, the Wi-Fi drivers with Kismet's channel glue, and the MM8108 driver, which
# kismet_cap_mm8108_halow links with the core
LIB = libuwifi.a
LIB_WIFI = libuwifi_wifi.a
LIB_MM8108 = libuwifi_mm8108.a
LIBS = $(LIB) $(LIB_WIFI) $(LIB_MM8108)

MONITOR_BIN = kismet_cap_usbwifi
TOOL = $(V)/uwifi

# The tool can present the adapter as a Linux Wi-Fi device through mac80211_hwsim
ifeq ($(shell uname -s),Linux)
HWSIM_OBJS = \
	$(V)/hwsim/genl.o \
	$(V)/hwsim/hwsim.o
TOOL_CFLAGS = -DUWIFI_HWSIM
endif

CORE_OBJS = $(KCOMPAT_OBJS) $(MAC80211_OBJS) $(COMMON_OBJS)
WIFI_OBJS = $(MT76_OBJS) $(RTW88_OBJS) $(GLUE_OBJS) $(KISMET_OBJS)
ALL_OBJS = $(CORE_OBJS) $(WIFI_OBJS) $(MM8108_OBJS) $(HWSIM_OBJS) capture_usbwifi.o $(V)/tools/uwifi.o

# Drivers register from constructors, so the whole archives are linked
ifeq ($(shell uname -s),Darwin)
whole_archive = $(foreach a,$(1),-Wl,-force_load,$(a)) -Wl,-dead_strip
else
whole_archive = -Wl,--whole-archive $(1) -Wl,--no-whole-archive -Wl,--gc-sections
endif

all: $(MONITOR_BIN) $(TOOL)

libs: $(LIBS)

$(LIB): $(CORE_OBJS)
	rm -f $@
	$(AR) rcs $@ $^

$(LIB_WIFI): $(WIFI_OBJS)
	rm -f $@
	$(AR) rcs $@ $^

$(LIB_MM8108): $(MM8108_OBJS)
	rm -f $@
	$(AR) rcs $@ $^

$(MONITOR_BIN): capture_usbwifi.o $(LIB) $(LIB_WIFI) ../libkismetdatasource.a
	$(CC) $(LDFLAGS) -pthread -o $@ capture_usbwifi.o $(call whole_archive,$(LIB) $(LIB_WIFI)) \
		../libkismetdatasource.a $(LIBUSBLIBS) $(FIRMWARELIBS) $(DATASOURCE_LIBS) -lm

# Only the firmware file reader comes from the datasource library
$(TOOL): $(V)/tools/uwifi.o $(HWSIM_OBJS) $(LIBS) ../libkismetdatasource.a
	$(CC) $(LDFLAGS) -pthread -o $@ $(V)/tools/uwifi.o $(HWSIM_OBJS) $(call whole_archive,$(LIBS)) \
		../libkismetdatasource.a $(LIBUSBLIBS) $(FIRMWARELIBS) -lm

capture_usbwifi.o: capture_usbwifi.c
	$(CC) $(CAP_CFLAGS) -c $< -o $@

common/wifi_ht_channels.o: ../wifi_ht_channels.c
	$(CC) $(OWN_CFLAGS) -c $< -o $@

$(V)/tools/uwifi.o: $(V)/tools/uwifi.c
	$(CC) $(OWN_CFLAGS) $(TOOL_CFLAGS) -DFIRMWAREDIR=\"$(FIRMWAREDIR)\" -c $< -o $@

# Netlink against the system's Linux headers rather than kcompat's
$(V)/hwsim/genl.o: $(V)/hwsim/genl.c
	$(CC) -std=gnu11 -pthread -MMD -MP -O2 -g -fPIE -Wall -Wextra $(CFLAGS) -c $< -o $@

# Kernel module names, as the driver reports them
$(V)/drivers/mt76/mt7921/usb.o: MODNAME = mt7921u
$(V)/drivers/mt76/mt7925/usb.o: MODNAME = mt7925u
$(V)/drivers/mt76/mt76x2/usb.o: MODNAME = mt76x2u
# Short names (rtw8814au rather than rtw88_8814au), so adapters are rtw8814a-0
$(V)/drivers/rtw88/%.o: MODNAME = rtw88
$(V)/drivers/rtw88/rtw8812au.o: MODNAME = rtw8812au
$(V)/drivers/rtw88/rtw8821au.o: MODNAME = rtw8821au
$(V)/drivers/rtw88/rtw8814au.o: MODNAME = rtw8814au
$(V)/drivers/rtw88/rtw8822bu.o: MODNAME = rtw8822bu
$(V)/drivers/rtw88/rtw8822cu.o: MODNAME = rtw8822cu
$(V)/drivers/rtw88/rtw8821cu.o: MODNAME = rtw8821cu
$(V)/drivers/rtw88/rtw8723du.o: MODNAME = rtw8723du

$(V)/drivers/mt76/%.o: $(V)/drivers/mt76/%.c
	$(CC) $(DRV_CFLAGS) -c $< -o $@

$(V)/drivers/rtw88/%.o: $(V)/drivers/rtw88/%.c
	$(CC) $(RTW88_CFLAGS) -c $< -o $@

$(V)/kcompat/upstream/%.o: $(V)/kcompat/upstream/%.c
	$(CC) $(KC_CFLAGS) -w -c $< -o $@

%.o: %.c
	$(CC) $(OWN_CFLAGS) -c $< -o $@

clean:
	@-rm -f $(MONITOR_BIN) $(TOOL) $(LIBS) $(ALL_OBJS) $(ALL_OBJS:.o=.d)

.PHONY: all libs clean

-include $(ALL_OBJS:.o=.d)
