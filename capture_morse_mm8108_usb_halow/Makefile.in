include ../Makefile.inc

# Morse Micro MM8108 USB 802.11ah (Wi-Fi HaLow) adapters, through the userspace-wifi mm8108
# driver built in ../capture_userspace_usb_wifi (see README.md)

prefix = @prefix@
datarootdir = @datarootdir@
FIRMWAREDIR = @datadir@/kismet/firmware

UWIFI = ../capture_userspace_usb_wifi
V = $(UWIFI)/userspace-wifi

# The archives come from the top-level build, which makes them once before this
UWIFI_LIBS = $(UWIFI)/libuwifi.a $(UWIFI)/libuwifi_mm8108.a

# The channel glue uses the kernel headers, as the driver does
KC_INCLUDES = -I$(V)/kcompat/include -I$(V)/kcompat/upstream -I$(V)/kcompat/upstream/uapi
GLUE_CFLAGS = -std=gnu11 -pthread -MMD -MP $(KC_INCLUDES) $(LIBUSBCFLAGS) -O2 -g -fPIE \
	-Wall -Wextra @USBWIFI_WNOCFLAGS@ -I$(V) -I$(V)/mac80211 -I$(V)/drivers

# The capture binary uses Kismet's headers, not kcompat's
CAP_CFLAGS = $(CFLAGS) -MMD -MP -I.. -DFIRMWAREDIR=\"$(FIRMWAREDIR)\"

OBJS = capture_mm8108.o mm8108_kismet.o
MONITOR_BIN = kismet_cap_mm8108_halow

# Drivers register from constructors, so the whole archives are linked
ifeq ($(shell uname -s),Darwin)
WHOLE_ARCHIVE = $(foreach a,$(UWIFI_LIBS),-Wl,-force_load,$(a)) -Wl,-dead_strip
else
WHOLE_ARCHIVE = -Wl,--whole-archive $(UWIFI_LIBS) -Wl,--no-whole-archive -Wl,--gc-sections
endif

all: $(MONITOR_BIN)

$(MONITOR_BIN): $(OBJS) $(UWIFI_LIBS) ../libkismetdatasource.a
	$(CC) $(LDFLAGS) -pthread -o $@ $(OBJS) $(WHOLE_ARCHIVE) ../libkismetdatasource.a \
		$(LIBUSBLIBS) $(FIRMWARELIBS) $(DATASOURCE_LIBS) -lm

capture_mm8108.o: capture_mm8108.c
	$(CC) $(CAP_CFLAGS) -c $< -o $@

mm8108_kismet.o: mm8108_kismet.c
	$(CC) $(GLUE_CFLAGS) -c $< -o $@

clean:
	@-rm -f $(MONITOR_BIN) $(OBJS) $(OBJS:.o=.d)

.PHONY: all clean

-include $(OBJS:.o=.d)
